      <!-- TAB 1: USER-WISE DAILY TIMESHEET VIEW -->
      <div id="tab-user_wise" style="<?= $activeTab === 'user_wise' ? 'display:block;' : 'display:none;' ?>">
        <?php if (empty($userWise)): ?>
          <div class="user-section-card" style="padding: 48px; text-align: center; color: var(--slate-500);">
            <i class="fa-solid fa-clock-rotate-left" style="font-size: 40px; color: var(--slate-300); margin-bottom: 12px; display: block;"></i>
            <h3>No Attendance Records Found</h3>
            <p style="font-size: 13px; margin-top: 4px;">Once supervisors punch in via the mobile app, their full all-day timesheets will appear here grouped user-wise.</p>
          </div>
        <?php else: ?>
          <?php foreach ($userWise as $uName => $uData): ?>
            <?php
              // If user filter applied, skip others
              if (!empty($selectedUserFilter) && strcasecmp($selectedUserFilter, $uName) !== 0) {
                  continue;
              }

              $totalHours = floor($uData['total_seconds'] / 3600);
              $totalMins = floor(($uData['total_seconds'] % 3600) / 60);
              $totalSecs = $uData['total_seconds'] % 60;
              $totalTimeStr = sprintf('%02d:%02d:%02d', $totalHours, $totalMins, $totalSecs);

              $userTotalOtSeconds = 0;
              foreach ($uData['days'] as $day) {
                  if ($day['day_seconds'] > $standardWorkingSeconds) {
                      $userTotalOtSeconds += ($day['day_seconds'] - $standardWorkingSeconds);
                  }
              }
              $uOtH = floor($userTotalOtSeconds / 3600);
              $uOtM = floor(($userTotalOtSeconds % 3600) / 60);
              $uOtS = $userTotalOtSeconds % 60;
              $userTotalOtStr = sprintf('%02d:%02d:%02d', $uOtH, $uOtM, $uOtS);
            ?>
            <div class="user-section-card user-block" data-user-name="<?= strtolower(htmlspecialchars($uName)) ?>">
              <!-- User Header -->
              <div class="user-header">
                <div class="user-identity">
                  <div class="user-badge-avatar"><?= htmlspecialchars($uData['initials']) ?></div>
                  <div class="user-meta">
                    <h3><?= htmlspecialchars($uName) ?></h3>
                    <div class="sub">
                      <span><i class="fa-solid fa-id-badge"></i> <?= htmlspecialchars($uData['employee_id']) ?></span>
                      <span>•</span>
                      <span><i class="fa-solid fa-calendar-check"></i> <?= count($uData['days']) ?> Days Worked</span>
                    </div>
                  </div>
                </div>

                <div class="user-stats-pill">
                  <div class="stat-mini">Total Shifts: <strong><?= $uData['total_shifts'] ?></strong></div>
                  <div class="stat-mini">
                    Total Time: <strong><?= $totalTimeStr ?></strong>
                    <?php if ($userTotalOtSeconds > 0): ?>
                      <span class="badge" style="background: #8b5cf6; color: white; font-size: 10px; margin-left: 5px; padding: 2px 6px;">
                        <i class="fa-solid fa-arrow-trend-up"></i> OT: <?= $userTotalOtStr ?>
                      </span>
                    <?php endif; ?>
                  </div>
                </div>
              </div>

              <!-- Day by Day Listing -->
              <div class="user-days-container">
                <?php foreach ($uData['days'] as $dKey => $day): ?>
                  <?php
                    $dHrs = floor($day['day_seconds'] / 3600);
                    $dMins = floor(($day['day_seconds'] % 3600) / 60);
                    $dayTimeFormatted = ($dHrs > 0 ? "{$dHrs}h " : "") . "{$dMins}m";
                    $pInFirst = strtotime($day['first_in']);
                    $pOutLast = !empty($day['last_out']) ? strtotime($day['last_out']) : null;
                  ?>
                  <div class="day-card open day-item" data-date="<?= $dKey ?>">
                    <!-- Day Bar (Clickable Accordion) -->
                    <div class="day-header" onclick="toggleDay(this)">
                      <div class="day-title-wrap">
                        <div class="day-calendar-box">
                          <span class="cal-month"><?= date('M', $pInFirst) ?></span>
                          <span class="cal-num"><?= date('d', $pInFirst) ?></span>
                        </div>
                        <div class="day-info">
                          <h4><?= $day['day_name'] ?>, <?= $day['formatted_date'] ?></h4>
                          <span>
                            First In: <strong><?= date('h:i A', $pInFirst) ?></strong>
                            <?php if ($pOutLast): ?>
                              • Last Out: <strong><?= date('h:i A', $pOutLast) ?></strong>
                            <?php endif; ?>
                            • <?= count($day['punches']) ?> Site Visit<?= count($day['punches']) > 1 ? 's' : '' ?>
                          </span>
                        </div>
                      </div>

                      <div class="day-summary-badges">
                        <!-- Sites Visited Tags -->
                        <?php foreach ($day['sites'] as $sName): ?>
                          <span class="badge badge-neutral"><i class="fa-solid fa-city"></i> <?= htmlspecialchars($sName) ?></span>
                        <?php endforeach; ?>

                        <!-- Day Working Hours -->
                        <span class="badge badge-primary">
                          <i class="fa-regular fa-clock"></i> <?= $dayTimeFormatted ?>
                        </span>

                        <!-- Daily Overtime -->
                        <?php if ($day['day_seconds'] > $standardWorkingSeconds): ?>
                          <?php
                            $otSecs = $day['day_seconds'] - $standardWorkingSeconds;
                            $otH = floor($otSecs / 3600);
                            $otM = floor(($otSecs % 3600) / 60);
                            $otS = $otSecs % 60;
                            $otFormatted = sprintf('%02d:%02d:%02d', $otH, $otM, $otS);
                          ?>
                          <span class="badge" style="background: #8b5cf6; color: white;">
                            <i class="fa-solid fa-arrow-trend-up"></i> OT: <?= $otFormatted ?>
                          </span>
                        <?php endif; ?>

                        <!-- Status Badge -->
                        <?php if ($day['has_active']): ?>
                          <span class="badge badge-warning">
                            <i class="fa-solid fa-spinner fa-spin"></i> Active Shift
                          </span>
                        <?php else: ?>
                          <span class="badge badge-success">
                            <i class="fa-solid fa-check"></i> Completed
                          </span>
                        <?php endif; ?>

                        <i class="fa-solid fa-chevron-down toggle-icon"></i>
                      </div>
                    </div>

                    <!-- Day Expanded Punch Details Table -->
                    <div class="day-content">
                      <table class="punches-table">
                        <thead>
                          <tr>
                            <th>Construction Site</th>
                            <th>Punch In Time</th>
                            <th>Punch Out Time</th>
                            <th>Duration</th>
                            <th style="text-align: right; width: 100px;">Details</th>
                          </tr>
                        </thead>
                        <tbody>
                          <?php foreach ($day['punches'] as $idx => $p): ?>
                            <?php
                              $pIn = strtotime($p['punch_in_time']);
                              $pOut = !empty($p['punch_out_time']) ? strtotime($p['punch_out_time']) : null;
                              $pLat = (float)($p['punch_in_latitude'] ?? 0);
                              $pLng = (float)($p['punch_in_longitude'] ?? 0);
                              $mapLink = "https://www.google.com/maps?q={$pLat},{$pLng}";

                              $pDuration = 'Live';
                              if ($pOut) {
                                  $diff = $pOut - $pIn;
                                  $h = floor($diff / 3600);
                                  $m = floor(($diff % 3600) / 60);
                                  $s = $diff % 60;
                                  $pDuration = sprintf('%02d:%02d:%02d', $h, $m, $s);
                              } else {
                                  $diff = time() - $pIn;
                                  $h = floor($diff / 3600);
                                  $m = floor(($diff % 3600) / 60);
                                  $s = $diff % 60;
                                  $pDuration = sprintf('%02d:%02d:%02d', $h, $m, $s) . " (active)";
                              }
                            ?>
                            <tr>
                              <td>
                                <strong><?= htmlspecialchars($p['site_name']) ?></strong>
                              </td>
                              <td>
                                <strong style="color: var(--slate-900);"><?= date('h:i:s A', $pIn) ?></strong>
                              </td>
                              <td>
                                <?php if ($pOut): ?>
                                  <strong style="color: var(--slate-800);"><?= date('h:i:s A', $pOut) ?></strong>
                                <?php else: ?>
                                  <span class="badge badge-warning" style="font-size: 11px;">
                                    <i class="fa-solid fa-spinner fa-spin"></i> In Progress
                                  </span>
                                <?php endif; ?>
                              </td>
                              <td>
                                <strong style="color: <?= $pOut ? 'var(--slate-700)' : 'var(--success)' ?>;"><?= $pDuration ?></strong>
                              </td>
                              <td style="text-align: right; white-space: nowrap;">
                                <button type="button" class="btn btn-outline" style="padding: 5px 8px; font-size: 12px; color: var(--primary);" 
                                        onclick="document.getElementById('details-<?= (int)$p['id'] ?>').style.display = document.getElementById('details-<?= (int)$p['id'] ?>').style.display === 'none' ? 'table-row' : 'none'" 
                                        title="View More Details">
                                  View More <i class="fa-solid fa-chevron-down" style="margin-left: 4px; font-size: 10px;"></i>
                                </button>
                              </td>
                            </tr>
                            <tr id="details-<?= (int)$p['id'] ?>" style="display: none; background: #f8fafc;">
                              <td colspan="5" style="padding: 16px; border-bottom: 2px solid var(--slate-200);">
                                <div style="display: flex; gap: 24px; flex-wrap: wrap;">
                                  <div>
                                    <strong style="font-size: 11px; text-transform: uppercase; color: var(--slate-500); display: block; margin-bottom: 6px;">Status / Verification</strong>
                                    <span class="badge <?= !empty($p['is_within_geofence']) ? 'badge-success' : 'badge-danger' ?>">
                                      <?= !empty($p['is_within_geofence']) ? 'Verified' : 'Outside' ?>
                                    </span>
                                  </div>
                                  <div>
                                    <strong style="font-size: 11px; text-transform: uppercase; color: var(--slate-500); display: block; margin-bottom: 6px;">Location / GPS</strong>
                                    <?php if ($pLat != 0 && $pLng != 0): ?>
                                      <a href="<?= $mapLink ?>" target="_blank" class="coords-link" title="Open GPS Coordinates in Google Maps">
                                        <i class="fa-solid fa-location-dot" style="color: #EF4444;"></i>
                                        <?= number_format($pLat, 4) ?>, <?= number_format($pLng, 4) ?>
                                      </a>
                                      <br><small style="color: var(--slate-500);"><?= (int)$p['distance_meters'] ?>m from geofence</small>
                                    <?php else: ?>
                                      <span style="color: var(--slate-400);">GPS Standby</span>
                                    <?php endif; ?>
                                  </div>
                                  <div>
                                    <strong style="font-size: 11px; text-transform: uppercase; color: var(--slate-500); display: block; margin-bottom: 6px;">Photos</strong>
                                    <div class="photo-thumb-wrap">
                                      <?php if (!empty($p['photo_url'])): ?>
                                        <div class="photo-item" title="Click to view Punch In Photo">
                                          <img src="<?= htmlspecialchars($p['photo_url']) ?>" class="photo-thumb" onclick="previewPhoto('<?= htmlspecialchars($p['photo_url']) ?>', 'Punch In Photo • <?= htmlspecialchars($uName) ?> (<?= htmlspecialchars($p['site_name']) ?>)')" alt="In Photo">
                                          <span class="photo-tag">IN</span>
                                        </div>
                                      <?php endif; ?>
                                      <?php if (!empty($p['punch_out_photo_url'])): ?>
                                        <div class="photo-item" title="Click to view Punch Out Photo">
                                          <img src="<?= htmlspecialchars($p['punch_out_photo_url']) ?>" class="photo-thumb" onclick="previewPhoto('<?= htmlspecialchars($p['punch_out_photo_url']) ?>', 'Punch Out Photo • <?= htmlspecialchars($uName) ?> (<?= htmlspecialchars($p['site_name']) ?>)')" alt="Out Photo">
                                          <span class="photo-tag" style="background:#0066FF;">OUT</span>
                                        </div>
                                      <?php endif; ?>
                                      <?php if (empty($p['photo_url']) && empty($p['punch_out_photo_url'])): ?>
                                        <span style="color: var(--slate-400); font-size: 11px;">No photo</span>
                                      <?php endif; ?>
                                    </div>
                                  </div>
                                  <div style="flex: 1; min-width: 200px;">
                                    <strong style="font-size: 11px; text-transform: uppercase; color: var(--slate-500); display: block; margin-bottom: 6px;">Notes</strong>
                                    <div style="font-size: 12px; color: var(--slate-700); white-space: pre-line;">
                                      <?= !empty($p['notes']) ? htmlspecialchars($p['notes']) : '<span style="color:var(--slate-400);">- No notes provided -</span>' ?>
                                    </div>
                                  </div>
                                  <div style="text-align: right;">
                                    <strong style="font-size: 11px; text-transform: uppercase; color: var(--slate-500); display: block; margin-bottom: 6px;">Action</strong>
                                    <button type="button" class="btn btn-outline" style="padding: 5px 12px; font-size: 12px; color: #EF4444; border-color: rgba(239, 68, 68, 0.25);" 
                                            onclick="promptDeleteAttendance(<?= (int)$p['id'] ?>, '<?= htmlspecialchars(addslashes($uName)) ?>', '<?= htmlspecialchars(addslashes($p['site_name'])) ?>', '<?= date('M d, h:i A', $pIn) ?>')" 
                                            title="Delete Attendance Record">
                                      <i class="fa-solid fa-trash-can"></i> Delete
                                    </button>
                                  </div>
                                </div>
                              </td>
                            </tr>
                          <?php endforeach; ?>
                        </tbody>
                        <tfoot>
                          <tr>
                            <td colspan="5" style="background: #f8fafc; padding: 14px 20px; border-top: 2px solid var(--slate-200);">
                               <div style="display: flex; gap: 40px; font-size: 13px; align-items: center; justify-content: flex-end;">
                                 <div>
                                   <span style="color: var(--slate-500); text-transform: uppercase; font-size: 11px; font-weight: 700; display: block; margin-bottom: 2px;">Standard Hours</span>
                                   <strong style="color: var(--slate-700); font-size: 14px;"><?= $standardWorkingHours ?>h 00m</strong>
                                 </div>
                                 <div>
                                   <span style="color: var(--slate-500); text-transform: uppercase; font-size: 11px; font-weight: 700; display: block; margin-bottom: 2px;">Total Logged Time</span>
                                   <strong style="color: var(--slate-900); font-size: 14px;"><?= $dayTimeFormatted ?></strong>
                                 </div>
                                 <div>
                                   <span style="color: var(--slate-500); text-transform: uppercase; font-size: 11px; font-weight: 700; display: block; margin-bottom: 2px;">Overtime Earned</span>
                                   <?php if ($day['day_seconds'] > $standardWorkingSeconds): ?>
                                     <?php
                                        $fOtSecs = $day['day_seconds'] - $standardWorkingSeconds;
                                        $fOtFormatted = sprintf('%02d:%02d:%02d', floor($fOtSecs / 3600), floor(($fOtSecs % 3600) / 60), $fOtSecs % 60);
                                     ?>
