<?php
require_once dirname(__DIR__) . '/backend/config/database.php';
require_login('login.php');
$currentUser = current_user();

$alertSuccess = '';
$alertError = '';

// Handle POST actions (delete single record, clean duplicates)
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $action = $_POST['action'] ?? '';
    if ($action === 'delete_attendance') {
        $id = (int)($_POST['id'] ?? 0);
        if ($id > 0) {
            $del = $pdo->prepare("DELETE FROM `attendance` WHERE `id` = ?");
            $del->execute([$id]);
            $alertSuccess = "Attendance record #{$id} has been permanently deleted.";
        }
    } elseif ($action === 'update_working_hours') {
        $hours = (int)($_POST['working_hours'] ?? 8);
        $pdo->prepare("INSERT INTO `system_meta` (`meta_key`, `meta_value`) VALUES ('working_hours', ?) ON DUPLICATE KEY UPDATE `meta_value` = ?")->execute([$hours, $hours]);
        $alertSuccess = "Standard working hours updated to {$hours}h.";
    } elseif ($action === 'clean_duplicates') {
        // Query duplicate records within 120 seconds
        $dupQuery = "
            SELECT a2.id AS duplicate_id
            FROM `attendance` a1
            JOIN `attendance` a2 
              ON (a1.supervisor_name = a2.supervisor_name OR a1.employee_id = a2.employee_id)
              AND a1.site_name = a2.site_name
              AND a1.id < a2.id
              AND ABS(TIMESTAMPDIFF(SECOND, a1.punch_in_time, a2.punch_in_time)) <= 120
        ";
        $stmt = $pdo->query($dupQuery);
        $dupIds = $stmt->fetchAll(PDO::FETCH_COLUMN);

        $deletedCount = 0;
        if (!empty($dupIds)) {
            $inQuery = implode(',', array_map('intval', $dupIds));
            $deletedCount = $pdo->exec("DELETE FROM `attendance` WHERE `id` IN ($inQuery)");
        }

        // Auto-close orphaned unclosed active shifts if the user has newer shifts that are already closed
        $closeOrphaned = $pdo->exec("
            UPDATE `attendance` a
            JOIN `attendance` newer 
              ON (a.supervisor_name = newer.supervisor_name OR a.employee_id = newer.employee_id)
              AND newer.punch_in_time > a.punch_in_time
            SET a.punch_out_time = newer.punch_in_time,
                a.notes = CASE 
                    WHEN a.notes IS NOT NULL AND a.notes != '' THEN CONCAT(a.notes, '\n[Auto-Closed]: Synchronized before subsequent punch')
                    ELSE '[Auto-Closed]: Synchronized before subsequent punch'
                END
            WHERE a.punch_out_time IS NULL
        ");

        $alertSuccess = "Cleaned {$deletedCount} duplicate punch records and synchronized {$closeOrphaned} orphaned active shifts.";
    }
}

// Fetch standard working hours setting
$whStmt = $pdo->query("SELECT `meta_value` FROM `system_meta` WHERE `meta_key` = 'working_hours'");
$wh = $whStmt->fetchColumn();
$standardWorkingHours = $wh ? (int)$wh : 8;
$standardWorkingSeconds = $standardWorkingHours * 3600;

// Fetch all attendance records from MySQL
$stmt = $pdo->query("SELECT * FROM `attendance` ORDER BY `punch_in_time` DESC");
$logs = $stmt->fetchAll();

// Detect duplicates
$dupCountQuery = "
    SELECT COUNT(*) 
    FROM `attendance` a1
    JOIN `attendance` a2 
      ON (a1.supervisor_name = a2.supervisor_name OR a1.employee_id = a2.employee_id)
      AND a1.site_name = a2.site_name
      AND a1.id < a2.id
      AND ABS(TIMESTAMPDIFF(SECOND, a1.punch_in_time, a2.punch_in_time)) <= 120
";
$dupCount = (int)$pdo->query($dupCountQuery)->fetchColumn();

// Fetch all users for user filter
$userStmt = $pdo->query("SELECT `id`, `full_name`, `username`, `employee_id`, `role`, `department` FROM `users` ORDER BY `full_name` ASC");
$allUsers = $userStmt->fetchAll();

// Global metrics
$totalPunches = count($logs);
$activeShifts = 0;
$todayPunches = 0;
$todayDate = date('Y-m-d');

// Build User-Wise & Day-Wise Grouping
$userWise = [];
foreach ($logs as $l) {
    $uName = !empty($l['supervisor_name']) ? trim($l['supervisor_name']) : 'Unknown User';
    $empId = !empty($l['employee_id']) ? trim($l['employee_id']) : ('SUP-' . $l['id']);
    $dateKey = substr($l['punch_in_time'], 0, 10);

    if (empty($l['punch_out_time'])) $activeShifts++;
    if ($dateKey === $todayDate) $todayPunches++;

    if (!isset($userWise[$uName])) {
        // Initials
        $parts = explode(' ', $uName);
        $initials = count($parts) >= 2 
            ? strtoupper(substr($parts[0], 0, 1) . substr($parts[count($parts) - 1], 0, 1))
            : strtoupper(substr($uName, 0, 2));

        $userWise[$uName] = [
            'name'           => $uName,
            'employee_id'    => $empId,
            'initials'       => $initials ?: 'SU',
            'total_shifts'   => 0,
            'total_seconds'  => 0,
            'days'           => []
        ];
    }

    $pInTime = strtotime($l['punch_in_time']);
    $pOutTime = !empty($l['punch_out_time']) ? strtotime($l['punch_out_time']) : null;
    $durationSec = $pOutTime ? max(0, $pOutTime - $pInTime) : max(0, time() - $pInTime);

    $userWise[$uName]['total_shifts']++;
    $userWise[$uName]['total_seconds'] += $durationSec;

    if (!isset($userWise[$uName]['days'][$dateKey])) {
        $userWise[$uName]['days'][$dateKey] = [
            'date'           => $dateKey,
            'day_name'       => date('l', $pInTime),
            'formatted_date' => date('M d, Y', $pInTime),
            'first_in'       => $l['punch_in_time'],
            'last_out'       => $l['punch_out_time'],
            'day_seconds'    => 0,
            'has_active'     => false,
            'sites'          => [],
            'punches'        => []
        ];
    }

    $userWise[$uName]['days'][$dateKey]['day_seconds'] += $durationSec;
    if (empty($l['punch_out_time'])) {
        $userWise[$uName]['days'][$dateKey]['has_active'] = true;
    }
    if (!in_array($l['site_name'], $userWise[$uName]['days'][$dateKey]['sites'])) {
        $userWise[$uName]['days'][$dateKey]['sites'][] = $l['site_name'];
    }

    $userWise[$uName]['days'][$dateKey]['punches'][] = $l;
}

// Default filter selection from query params
$selectedUserFilter = trim($_GET['user'] ?? '');
$activeTab = $_GET['tab'] ?? 'user_wise';
?>
