                <th style="padding: 12px 18px; text-align: right; width: 70px;">Action</th>
              </tr>
            </thead>
            <tbody>
              <?php if (empty($logs)): ?>
                <tr><td colspan="10" style="text-align: center; padding: 24px; color: var(--slate-500);">No attendance records found.</td></tr>
              <?php else: ?>
                <?php foreach ($logs as $l): ?>
                  <?php
                    $pIn = strtotime($l['punch_in_time']);
                    $pOut = !empty($l['punch_out_time']) ? strtotime($l['punch_out_time']) : null;
                    $lat = (float)($l['punch_in_latitude'] ?? 0);
                    $lng = (float)($l['punch_in_longitude'] ?? 0);
                    $mUrl = "https://www.google.com/maps?q={$lat},{$lng}";

                    $dur = 'Live Shift';
                    if ($pOut) {
                        $diff = $pOut - $pIn;
                        $h = floor($diff / 3600);
                        $m = floor(($diff % 3600) / 60);
                        $s = $diff % 60;
                        $dur = sprintf('%02d:%02d:%02d', $h, $m, $s);
                    }
                  ?>
                  <tr style="border-bottom: 1px solid var(--slate-200);">
                    <td style="padding: 14px 18px;">
                      <strong><?= date('M d, Y', $pIn) ?></strong><br>
                      <small style="color: var(--slate-500);"><?= date('h:i A', $pIn) ?></small>
                    </td>
                    <td style="padding: 14px 18px;">
                      <strong><?= htmlspecialchars($l['supervisor_name']) ?></strong><br>
                      <small style="color: var(--slate-500); font-family: monospace;"><?= htmlspecialchars($l['employee_id']) ?></small>
                    </td>
                    <td style="padding: 14px 18px;">
                      <strong><?= htmlspecialchars($l['site_name']) ?></strong>
                    </td>
                    <td style="padding: 14px 18px;">
                      <strong><?= date('h:i A', $pIn) ?></strong>
                    </td>
                    <td style="padding: 14px 18px;">
                      <?php if ($lat != 0 && $lng != 0): ?>
                        <a href="<?= $mUrl ?>" target="_blank" class="coords-link">
                          <i class="fa-solid fa-location-dot" style="color: #EF4444;"></i>
                          <?= number_format($lat, 4) ?>, <?= number_format($lng, 4) ?>
                        </a>
                        <br><small style="color: var(--slate-500);"><?= (int)$l['distance_meters'] ?>m</small>
                      <?php else: ?>
                        <span style="color: var(--slate-400);">GPS Standby</span>
                      <?php endif; ?>
                    </td>
                    <td style="padding: 14px 18px;">
                      <div class="photo-thumb-wrap">
                        <?php if (!empty($l['photo_url'])): ?>
                          <div class="photo-item">
                            <img src="<?= htmlspecialchars($l['photo_url']) ?>" class="photo-thumb" onclick="previewPhoto('<?= htmlspecialchars($l['photo_url']) ?>', 'Punch In Photo • <?= htmlspecialchars($l['supervisor_name']) ?>')" alt="Punch Photo">
                            <span class="photo-tag">IN</span>
                          </div>
                        <?php endif; ?>
                        <?php if (!empty($l['punch_out_photo_url'])): ?>
                          <div class="photo-item">
                            <img src="<?= htmlspecialchars($l['punch_out_photo_url']) ?>" class="photo-thumb" onclick="previewPhoto('<?= htmlspecialchars($l['punch_out_photo_url']) ?>', 'Punch Out Photo • <?= htmlspecialchars($l['supervisor_name']) ?>')" alt="Out Photo">
                            <span class="photo-tag" style="background:#0066FF;">OUT</span>
                          </div>
                        <?php endif; ?>
                      </div>
                    </td>
                    <td style="padding: 14px 18px;">
                      <?= $pOut ? date('h:i A', $pOut) : '<span class="badge badge-warning">Active Shift</span>' ?>
                    </td>
                    <td style="padding: 14px 18px;">
                      <strong><?= $dur ?></strong>
                    </td>
                    <td style="padding: 14px 18px;">
                      <span class="badge <?= !empty($l['is_within_geofence']) ? 'badge-success' : 'badge-danger' ?>">
                        <?= !empty($l['is_within_geofence']) ? 'Verified' : 'Outside' ?>
                      </span>
                    </td>
                    <td style="padding: 14px 18px; text-align: right; white-space: nowrap;">
                      <button type="button" class="btn btn-outline" style="padding: 5px 8px; font-size: 12px; color: #EF4444; border-color: rgba(239, 68, 68, 0.25);" 
                              onclick="promptDeleteAttendance(<?= (int)$l['id'] ?>, '<?= htmlspecialchars(addslashes($l['supervisor_name'])) ?>', '<?= htmlspecialchars(addslashes($l['site_name'])) ?>', '<?= date('M d, h:i A', $pIn) ?>')" 
                              title="Delete Attendance Record">
                        <i class="fa-solid fa-trash-can"></i>
                      </button>
                    </td>
                  </tr>
                <?php endforeach; ?>
              <?php endif; ?>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </main>

  <!-- Photo Preview Modal -->
  <div class="modal-overlay" id="photoModal" onclick="closePhotoModal()">
    <div class="photo-modal-card" onclick="event.stopPropagation()">
      <div class="photo-modal-title" id="previewTitle">Site Verification Photo</div>
      <img id="previewImg" src="" alt="Verification Photo">
      <div style="margin-top: 16px; display: flex; justify-content: flex-end; gap: 8px;">
        <button class="btn btn-outline" onclick="closePhotoModal()">Close</button>
      </div>
    </div>
  </div>

  <!-- Delete Attendance Confirmation Modal -->
  <div class="modal-overlay" id="deleteAttendanceModal" onclick="closeModal('deleteAttendanceModal')">
    <div class="photo-modal-card" style="max-width: 440px; text-align: left;" onclick="event.stopPropagation()">
      <div style="display: flex; align-items: flex-start; gap: 14px; margin-bottom: 16px;">
        <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(239, 68, 68, 0.12); display: flex; align-items: center; justify-content: center; color: #EF4444; font-size: 20px; flex-shrink: 0;">
          <i class="fa-solid fa-trash-can"></i>
        </div>
        <div>
          <h3 style="font-size: 16px; font-weight: 700; color: var(--slate-900); margin-bottom: 4px;">Delete Attendance Record</h3>
          <p style="font-size: 13px; color: var(--slate-500); line-height: 1.4;">
            Permanently remove this attendance punch from the database? This action cannot be undone.
          </p>
        </div>
      </div>

      <div style="background: var(--slate-50); border: 1px solid var(--slate-200); border-radius: var(--radius-md); padding: 12px 14px; margin-bottom: 20px; font-size: 13px;">
        <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
          <span style="color: var(--slate-500);">Supervisor:</span>
          <strong style="color: var(--slate-900);" id="deleteTargetSupervisor">-</strong>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
          <span style="color: var(--slate-500);">Site:</span>
          <strong style="color: var(--slate-900);" id="deleteTargetSite">-</strong>
        </div>
        <div style="display: flex; justify-content: space-between;">
          <span style="color: var(--slate-500);">Punch In:</span>
          <strong style="color: var(--slate-900);" id="deleteTargetTime">-</strong>
        </div>
      </div>

      <input type="hidden" id="pendingDeleteAttendanceId" value="">

      <div style="display: flex; justify-content: flex-end; gap: 10px;">
        <button type="button" class="btn btn-outline" onclick="closeModal('deleteAttendanceModal')">Cancel</button>
        <button type="button" class="btn btn-primary" id="confirmDeleteAttendanceBtn" style="background: #EF4444; border-color: #DC2626;" onclick="executeDeleteAttendance()">
          <i class="fa-solid fa-trash-can"></i> Yes, Delete Record
        </button>
      </div>
    </div>
  </div>

  <script>
    function openModal(id) {
      const el = document.getElementById(id);
      if (el) el.classList.add('open');
    }

    function closeModal(id) {
      const el = document.getElementById(id);
      if (el) el.classList.remove('open');
    }

    function promptDeleteAttendance(id, supervisor, site, time) {
      document.getElementById('pendingDeleteAttendanceId').value = id;
      document.getElementById('deleteTargetSupervisor').textContent = supervisor || 'Supervisor';
      document.getElementById('deleteTargetSite').textContent = site || 'Site';
      document.getElementById('deleteTargetTime').textContent = time || '-';
      const btn = document.getElementById('confirmDeleteAttendanceBtn');
      if (btn) {
        btn.innerHTML = '<i class="fa-solid fa-trash-can"></i> Yes, Delete Record';
        btn.disabled = false;
      }
      openModal('deleteAttendanceModal');
    }

    async function executeDeleteAttendance() {
      const id = document.getElementById('pendingDeleteAttendanceId').value;
      if (!id) return;

      const btn = document.getElementById('confirmDeleteAttendanceBtn');
      if (btn) {
        btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Deleting...';
        btn.disabled = true;
      }

      try {
        const res = await fetch('../backend/attendance/delete.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: id })
        });
        const result = await res.json();
        if (result.success) {
          closeModal('deleteAttendanceModal');
          showNotification(result.message || 'Record deleted successfully.', 'success');
          setTimeout(() => window.location.reload(), 600);
        } else {
          alert(result.message || 'Failed to delete attendance record.');
          if (btn) {
            btn.innerHTML = '<i class="fa-solid fa-trash-can"></i> Yes, Delete Record';
            btn.disabled = false;
          }
        }
      } catch (e) {
        // Fallback to direct form submit
        const f = document.createElement('form');
        f.method = 'POST';
        f.action = 'attendance.php';
        f.innerHTML = `<input type="hidden" name="action" value="delete_attendance"><input type="hidden" name="id" value="${id}">`;
        document.body.appendChild(f);
        f.submit();
      }
    }

    async function triggerCleanDuplicates() {
      if (!confirm("Are you sure you want to clean and purge duplicate attendance entries?\n\nThis will remove rapid duplicate punches (within 120s at the same site) and synchronize orphaned active shifts.")) {
        return;
      }
      try {
        const res = await fetch('../backend/attendance/delete.php?action=clean_duplicates', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'clean_duplicates' })
        });
        const result = await res.json();
        if (result.success) {
          showNotification(result.message || 'Duplicate records cleaned successfully.', 'success');
          setTimeout(() => window.location.reload(), 700);
        } else {
          alert(result.message || 'Failed to clean duplicates.');
        }
      } catch (e) {
        // Form post fallback
        const f = document.createElement('form');
        f.method = 'POST';
        f.action = 'attendance.php';
        f.innerHTML = `<input type="hidden" name="action" value="clean_duplicates">`;
        document.body.appendChild(f);
        f.submit();
      }
    }

    function showNotification(msg, type = 'success') {
      let toast = document.createElement('div');
      toast.style.cssText = `
        position: fixed; bottom: 24px; right: 24px; z-index: 99999;
        background: #0F172A; color: white; padding: 14px 20px;
        border-radius: 12px; border: 1px solid rgba(16, 185, 129, 0.4);
        box-shadow: 0 10px 25px rgba(0,0,0,0.5); font-size: 14px;
        display: flex; align-items: center; gap: 12px;
      `;
      toast.innerHTML = `<i class="fa-solid fa-circle-check" style="color: #10B981; font-size: 18px;"></i> <span>${msg}</span>`;
      document.body.appendChild(toast);
      setTimeout(() => toast.remove(), 3500);
    }

    function toggleDay(headerEl) {
      const card = headerEl.closest('.day-card');
      card.classList.toggle('open');
    }

    function switchTab(tab) {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.getElementById('tab-user_wise').style.display = tab === 'user_wise' ? 'block' : 'none';
      document.getElementById('tab-feed').style.display = tab === 'feed' ? 'block' : 'none';
      
      const btns = document.querySelectorAll('.tab-btn');
      if (tab === 'user_wise' && btns[0]) btns[0].classList.add('active');
      if (tab === 'feed' && btns[1]) btns[1].classList.add('active');
    }

    function applyUserFilter() {
      const selected = document.getElementById('userFilterSelect').value.toLowerCase().trim();
      const userBlocks = document.querySelectorAll('.user-block');
      userBlocks.forEach(b => {
        const uName = b.getAttribute('data-user-name') || '';
        if (!selected || uName === selected || uName.includes(selected)) {
          b.style.display = 'block';
        } else {
          b.style.display = 'none';
        }
      });
    }

    function applyDateFilter() {
      const selectedDate = document.getElementById('dateFilterInput').value;
      if (!selectedDate) {
        document.querySelectorAll('.day-item').forEach(d => d.style.display = 'block');
        return;
      }
      document.querySelectorAll('.day-item').forEach(d => {
        const dDate = d.getAttribute('data-date');
        d.style.display = (dDate === selectedDate) ? 'block' : 'none';
      });
    }

    function clearFilters() {
      document.getElementById('userFilterSelect').value = '';
      document.getElementById('dateFilterInput').value = '';
      document.querySelectorAll('.user-block').forEach(b => b.style.display = 'block');
      document.querySelectorAll('.day-item').forEach(d => d.style.display = 'block');
    }

    function previewPhoto(url, title) {
      document.getElementById('previewTitle').innerText = title || 'Site Verification Photo';
      document.getElementById('previewImg').src = url;
      document.getElementById('photoModal').classList.add('open');
    }

    function closePhotoModal() {
      document.getElementById('photoModal').classList.remove('open');
    }

    function exportCSV() {
      window.location.href = '../backend/attendance/list.php';
    }

    // Auto-apply initial filter if URL parameter exists
    window.addEventListener('DOMContentLoaded', () => {
      const urlParams = new URLSearchParams(window.location.search);
      const userParam = urlParams.get('user');
      if (userParam) {
        document.getElementById('userFilterSelect').value = userParam;
        applyUserFilter();
      }
    });
  </script>
</body>
</html>
