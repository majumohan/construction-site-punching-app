              <option value="<?= htmlspecialchars($u['full_name']) ?>" <?= $selectedUserFilter === $u['full_name'] ? 'selected' : '' ?>>
                <?= htmlspecialchars($u['full_name']) ?> (<?= htmlspecialchars($u['role']) ?>)
              </option>
            <?php endforeach; ?>
          </select>

          <label style="font-size: 13px; font-weight: 600; color: var(--slate-600); margin-left: 8px;">Date:</label>
          <input type="date" id="dateFilterInput" class="filter-select" onchange="applyDateFilter()">
