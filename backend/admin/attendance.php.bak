      <div id="tab-feed" style="<?= $activeTab === 'feed' ? 'display:block;' : 'display:none;' ?>">
        <div class="user-section-card">
          <div class="user-header">
            <h3>Chronological Activity Stream</h3>
            <span style="font-size: 13px; color: var(--slate-500);"><i class="fa-solid fa-bolt" style="color: var(--primary);"></i> All field punches in chronological order</span>
          </div>

          <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
            <thead>
              <tr style="background: var(--slate-50); border-bottom: 1px solid var(--slate-200);">
                <th style="padding: 12px 18px; text-align: left;">Date</th>
                <th style="padding: 12px 18px; text-align: left;">Supervisor</th>
                <th style="padding: 12px 18px; text-align: left;">Site Visited</th>
